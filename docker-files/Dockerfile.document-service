# ===== Stage 1: Build =====
FROM maven:3.9-eclipse-temurin-17-alpine AS build
WORKDIR /app

COPY pom.xml .
COPY eureka-server/pom.xml eureka-server/
COPY config-server/pom.xml config-server/
COPY auth-service/pom.xml auth-service/
COPY application-service/pom.xml application-service/
COPY document-service/pom.xml document-service/
COPY admin-service/pom.xml admin-service/
COPY api-gateway/pom.xml api-gateway/
COPY notification-service/pom.xml notification-service/
COPY payment-service/pom.xml payment-service/

RUN mvn dependency:go-offline -pl document-service -am -q

COPY document-service/src document-service/src

RUN mvn package -pl document-service -am -DskipTests -q -Dstart-class=com.finflow.document.DocumentServiceApplication

# ===== Stage 2: Runtime =====
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

RUN addgroup -S finflow && adduser -S finflow -G finflow

# Create upload dir as root, give ownership to finflow user
RUN mkdir -p /app/uploads/documents && chown -R finflow:finflow /app/uploads

USER finflow

COPY --from=build /app/document-service/target/*.jar app.jar

EXPOSE 8083

ENTRYPOINT ["java", "-jar", "app.jar"]
